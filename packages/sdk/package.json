{
  "name": "@prateekkumaroriginal/quiz-sdk",
  "version": "0.1.0",
  "description": "A type-safe TypeScript SDK for fetching validated quiz questions.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "src/index.ts"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@prateekkumaroriginal/quiz-contracts": "workspace:*",
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@prateekkumaroriginal/quiz-api": "workspace:*"
  }
}
