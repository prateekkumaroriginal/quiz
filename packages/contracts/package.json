{
  "name": "@prateekkumaroriginal/quiz-contracts",
  "version": "0.1.0",
  "description": "Runtime-validated contracts for a type-safe quiz API.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
