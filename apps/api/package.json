{
  "name": "@prateekkumaroriginal/quiz-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@prateekkumaroriginal/quiz-contracts": "workspace:*",
    "arktype": "^2.2.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}
